GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# ── Pipeline ─────────────────────────────────────────────────────────────
ODIN_MAX_ITERATIONS=3
ODIN_EXECUTION_TIMEOUT=10

# ── Sandbox ──────────────────────────────────────────────────────────────
# subprocess (default: isolated temp dir + OS limits) | docker (containerized)
ODIN_SANDBOX_MODE=subprocess
ODIN_SANDBOX_MEMORY_MB=1024
ODIN_SANDBOX_FILE_SIZE_MB=10

# ── Storage paths (relative to repo root) ────────────────────────────────
# Run folders — one per run, with per-iteration sub-directories
ODIN_OUTPUTS_PATH=./outputs

# ChromaDB data directory — contains two collections:
#   odin_knowledge  (static docs/API-ref knowledge base)
#   run_memory      (past-run memory for memory-augmented generation)
ODIN_CHROMA_DATA_PATH=./chroma_data

# ── run_memory tuning ────────────────────────────────────────────────────
# Minimum cosine similarity [0.0–1.0] for a past run to be surfaced as context.
# Lower = more matches (more noise); higher = fewer matches (fewer false positives).
ODIN_MEMORY_SIMILARITY_THRESHOLD=0.70
